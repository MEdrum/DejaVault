# Agent Memory Service — environment configuration
# Copy to `.env` and adjust values for your setup.
# Never commit the real `.env` file.

# --- SSH keys (mounted into the container for git push to remote) ---
# Referenced by docker-compose.yml via ${VAR} interpolation.
SSH_PRIVATE_KEY_PATH=/path/to/your/ssh/id_ed25519
SSH_PUBLIC_KEY_PATH=/path/to/your/ssh/id_ed25519.pub

# --- Optional: API authentication (not yet implemented, see TODO.md) ---
# API_KEY=